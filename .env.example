# RuralBiz AI - Environment Configuration Template
# Copy this file to .env and configure as needed

# Host and Port Configuration
PORT=8000
HOST=127.0.0.1

# Optional AI Advisory Provider Keys
# If provided, enables cloud LLM narrative enhancement.
# If omitted or blank, RuralBiz AI uses its built-in deterministic, evidence-grounded advisory engine without fabricating any data.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Open Government Data (data.gov.in) API Key (Optional)
# If provided, enables live real-time querying of the OGD Agmarknet commodities API.
# Register for a free API token at: https://www.data.gov.in/
DATA_GOV_IN_API_KEY=

# Database Location
DATABASE_URL=sqlite:///./backend/ruralbiz.db
